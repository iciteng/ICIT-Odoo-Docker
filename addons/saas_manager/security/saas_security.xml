<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_icit_admin" model="res.groups">
            <field name="name">ICIT Admin</field>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('base.group_multi_company')),
                (4, ref('base.group_erp_manager'))
            ]"/>
        </record>

        <record id="rule_saas_tenant_admin_all" model="ir.rule">
            <field name="name">SaaS Tenant: ICIT admins see all</field>
            <field name="model_id" ref="model_saas_tenant"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('saas_manager.group_icit_admin'))]"/>
        </record>

        <record id="rule_saas_tenant_user_company" model="ir.rule">
            <field name="name">SaaS Tenant: users see own company</field>
            <field name="model_id" ref="model_saas_tenant"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_saas_app_access_admin_all" model="ir.rule">
            <field name="name">SaaS App Access: ICIT admins see all</field>
            <field name="model_id" ref="model_saas_app_access"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('saas_manager.group_icit_admin'))]"/>
        </record>

        <record id="rule_saas_app_access_user_company" model="ir.rule">
            <field name="name">SaaS App Access: users see own company</field>
            <field name="model_id" ref="model_saas_app_access"/>
            <field name="domain_force">[('tenant_id.company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_saas_usage_log_admin_all" model="ir.rule">
            <field name="name">SaaS Usage Log: ICIT admins see all</field>
            <field name="model_id" ref="model_saas_usage_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('saas_manager.group_icit_admin'))]"/>
        </record>

        <record id="rule_saas_usage_log_user_company" model="ir.rule">
            <field name="name">SaaS Usage Log: users see own company</field>
            <field name="model_id" ref="model_saas_usage_log"/>
            <field name="domain_force">[('tenant_id.company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Prevent tenant users from installing/writing modules -->
        <record id="rule_module_install_icit_only" model="ir.rule">
            <field name="name">Module Install: ICIT admins only</field>
            <field name="model_id" ref="base.model_ir_module_module"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('saas_manager.group_icit_admin'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- =================================================================
             Multi-tenant isolation: core Odoo models
             =================================================================
             Odoo's default res.partner rule allows company_id=False (global
             records) to leak across tenants. We deactivate it and replace
             with strict company-only rules. Group rules are ORed, so ICIT
             admins get (1=1) OR (company match) = everything.
             ================================================================= -->

        <!-- Deactivate Odoo's default permissive partner rule -->
        <record id="base.res_partner_rule" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

        <!-- res.partner: ICIT admins see all -->
        <record id="rule_partner_icit_admin_all" model="ir.rule">
            <field name="name">Partners: ICIT admins see all</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('saas_manager.group_icit_admin'))]"/>
        </record>

        <!-- res.partner: tenant users see own company only -->
        <record id="rule_partner_tenant_company" model="ir.rule">
            <field name="name">Partners: tenants see own company only</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- res.partner: global tenant isolation with ICIT-admin bypass
             This is global (no groups) so it is ANDed with all other rules,
             preventing permissive OR-combinations from leaking contacts. -->
        <record id="rule_partner_global_tenant_isolation" model="ir.rule">
            <field name="name">Partners: global tenant isolation</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">
                user.has_group('saas_manager.group_icit_admin')
                and [(1, '=', 1)]
                or (
                    user.has_group('base.group_user')
                    and ['|', ('id', '=', user.partner_id.id), ('company_id', '=', user.company_id.id)]
                    or [('id', '=', -1)]
                )
            </field>
        </record>

        <!-- res.users: ICIT admins see all -->
        <record id="rule_users_icit_admin_all" model="ir.rule">
            <field name="name">Users: ICIT admins see all</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('saas_manager.group_icit_admin'))]"/>
        </record>

        <!-- res.users: tenant users see own company only -->
        <record id="rule_users_tenant_company" model="ir.rule">
            <field name="name">Users: tenants see own company only</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- res.users: global tenant isolation with ICIT-admin bypass -->
        <record id="rule_users_global_tenant_isolation" model="ir.rule">
            <field name="name">Users: global tenant isolation</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="domain_force">
                user.has_group('saas_manager.group_icit_admin')
                and [(1, '=', 1)]
                or (
                    user.has_group('base.group_user')
                    and [('company_id', '=', user.company_id.id)]
                    or [('id', '=', -1)]
                )
            </field>
        </record>
    </data>
</odoo>
