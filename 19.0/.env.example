# PostgreSQL Configuration
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_DB=postgres

# Database SSL Mode
# Local: disable
# DigitalOcean: require
DB_SSLMODE=disable

# For DigitalOcean Managed Database, uncomment and configure:
# HOST=your-db-cluster.db.ondigitalocean.com
# PORT=25060
# DB_SSLMODE=require
