# =============================================================================
# Production Environment Variables for DO App Platform
# =============================================================================
# Copy this to .env and fill in real values for local testing.
# In App Platform, set these via the console or app.yaml.

# -----------------------------------------------------------------------------
# Database Connection (DO Managed PostgreSQL)
# -----------------------------------------------------------------------------
HOST=your-db-cluster.db.ondigitalocean.com
PORT=25060
USER=doadmin
PASSWORD=your-db-password
DB_SSLMODE=require

# -----------------------------------------------------------------------------
# Odoo Admin Password
# -----------------------------------------------------------------------------
# Used for database management operations. Use a strong random value.
ODOO_ADMIN_PASSWD=generate-a-long-random-secret-here

# -----------------------------------------------------------------------------
# DO Spaces / S3 Configuration
# -----------------------------------------------------------------------------
# Required for persistent file storage (attachments, images, etc.)
SPACES_BUCKET=your-bucket-name
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_ACCESS_KEY=your-spaces-access-key
SPACES_SECRET_KEY=your-spaces-secret-key
SPACES_PREFIX=odoo

# -----------------------------------------------------------------------------
# Optional: Override default ports
# -----------------------------------------------------------------------------
# HTTP_PORT=8069
# LONGPOLLING_PORT=8072
